2. Create a view for invoice products[cname, , inv_id, product_id, quantity]

mysql> CREATE VIEW inv_pro AS SELECT customer.name, invoice_item.inv_id,  invoice_item.pid invoice_item.quantity FROM customer JOIN invoice_master ON customer.cust_id = invoice_master.cust_id JOIN invoice_item  ON invoice_master.inv_id = invoice_item.inv_id;
