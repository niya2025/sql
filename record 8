1.Create a view for customers who have purchased products. 
mysql> CREATE VIEW cust_po AS
    -> SELECT customer.name, customer.cust_id
    -> FROM customer
    -> JOIN invoice_master 
    -> ON customer.cust_id = invoice_master.cust_id;
